# ---------- bamboost ----------
# about: claims the Jito BAM Boost (JIP-31) of every open epoch and pays the JitoSOL out to your wallet (mainnet)
# Where the JitoSOL goes (install.sh asks). Only a live wallet: it exists on-chain, you
# hold its key off this server, not an exchange deposit address. Empty = the payout
# wallet of another module (VAT_PAYOUT_WALLET), with a warning; none at all = no run.
BAMBOOST_PAYOUT_WALLET=
# RPC for the claims and the payout. The public mainnet RPC by default: a validator's
# own RPC serves the calls bamboost needs only with --full-rpc-api.
BAMBOOST_RPC_URL=https://api.mainnet-beta.solana.com
# The current epoch is claimed not earlier than this many hours after it starts
# (install.sh picks a random one, 10..16). Older open epochs are claimed at once.
BAMBOOST_CURRENT_AFTER_HOURS=
# A spare node of a failover pair claims only epochs left unclaimed for this many epochs.
BAMBOOST_BACKUP_AFTER=10
# Hourly run: minute of the hour (install.sh picks a random one), plus a random delay.
BAMBOOST_TIMER_MINUTE=
BAMBOOST_TIMER_JITTER=15min
# Time zone of the log, like Asia/Tokyo. Empty = the server's time.
BAMBOOST_LOG_TZ=
# Telegram from bamboost: 1 = claims, payouts and problems, 0 = nothing.
BAMBOOST_TG=1
# 1 = only simulate, send nothing. Set 0 when a dry run looks right.
BAMBOOST_DRY_RUN=1
