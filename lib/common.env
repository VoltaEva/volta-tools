# volta-tools config: one file for all modules, written by install.sh.
# Read on every run, so edits apply right away. Run install.sh again to change
# settings with checks. Keep it chmod 600: it may hold your Telegram bot token.
# Addresses and file paths only, never private keys.

# ---------- validator (install.sh finds these) ----------
# systemd unit of the validator
VALIDATOR_UNIT=
# folder with solana and solana-keygen
SOLANA_BIN_DIR=
# agave-validator binary, used to ask the local validator who it runs as
VALIDATOR_BIN=
# identity keypair file the vote account belongs to
IDENTITY_KEYPAIR=
# vote account address
VOTE_ACCOUNT=
# ledger folder
LEDGER_DIR=
# RPC for balances and transfers
RPC_URL=http://127.0.0.1:8899

# ---------- telegram (optional, one bot for all modules) ----------
TG_BOT_TOKEN=
TG_CHAT_ID=
