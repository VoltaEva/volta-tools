# ---------- vat ----------
# about: keeps the vote account funded for VAT, sends spare identity SOL to your wallet
# Where spare identity SOL goes (install.sh asks). Only a live wallet: it exists on-chain,
# you hold its key off this server, not an exchange deposit address. Empty = the payout
# wallet of another module (BAMBOOST_PAYOUT_WALLET), with a warning; none at all = no run.
VAT_PAYOUT_WALLET=
# VAT taken from the vote account each epoch (0.8 SOL on mainnet), plus a small margin.
VAT_PER_EPOCH=0.83
# Top up the vote account when it holds VAT for fewer than VAT_LOW_EPOCHS epochs,
# and fill it up to VAT_RESERVE_EPOCHS. Same value in both = keep it always full.
VAT_LOW_EPOCHS=3
VAT_RESERVE_EPOCHS=5
# Rent-exempt minimum of the vote account, kept on top of the reserve.
VAT_RENT=0.03
# The identity keeps VAT_IDENTITY_MIN after a sweep.
# A vote top-up may take it down to VAT_IDENTITY_FLOOR, never lower.
VAT_IDENTITY_MIN=3
VAT_IDENTITY_FLOOR=1
# Don't sweep amounts smaller than this.
VAT_MIN_SWEEP=1
# Hourly run: minute of the hour (install.sh picks a random one), plus a random delay.
VAT_TIMER_MINUTE=
VAT_TIMER_JITTER=15min
# Telegram from vat: 1 = transfers and problems, 0 = nothing.
VAT_TG=1
# 1 = only log what would be sent. Set 0 when the log looks right.
VAT_DRY_RUN=1
